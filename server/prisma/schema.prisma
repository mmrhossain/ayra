  actorEmail String?
  actorRole  String?
  action     String?
  source     String   @default("APP")
  method     String
  path       String
  statusCode Int
  outcome    String   @default("SUCCESS")
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  requestId  String?
  durationMs Int?
