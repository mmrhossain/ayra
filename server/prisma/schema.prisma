// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                      @id
  name                   String
  email                  String
  emailVerified          Boolean                     @default(false)
  image                  String?
  imagePublicId          String?
  role                   String?                     @default("customer")
  adminPermissions       String[]                    @default([])
  adminActions           String[]                    @default([])
  isSuperAdmin           Boolean                     @default(false)
  staffStatus            StaffStatus                 @default(ACTIVE)
  banned                 Boolean?                    @default(false)
  banReason              String?
  banExpires             DateTime?
  sessions               Session[]
  accounts               Account[]
  notifications          Notification[]
  notificationPreference UserNotificationPreference?
  customerProfile        CustomerProfile?
  pushDevices            PushDevice[]
  staffInvitationsSent   StaffInvitation[]           @relation("StaffInvitationInviter")
  staffInvitationsAccepted StaffInvitation[]         @relation("StaffInvitationAcceptor")
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deletedAt              DateTime?

  @@unique([email])
  @@index([role])
  @@index([role, isSuperAdmin, staffStatus])
  @@map("user")
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model StaffInvitation {
  id            String                 @id @default(uuid())
  email         String
  name          String
  permissions   String[]               @default([])
  isSuperAdmin  Boolean                @default(false)
  tokenHash     String                 @unique
  status        StaffInvitationStatus  @default(PENDING)
  expiresAt     DateTime
  invitedById   String
  invitedBy     User                   @relation("StaffInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedById  String?
  acceptedBy    User?                  @relation("StaffInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  revokedAt     DateTime?
  revokedById   String?
  lastSentAt    DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([email, status])
  @@index([status, expiresAt])
  @@map("staff_invitation")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  // Better Auth 1.7.0-1.7.2 wrote this column; 1.7.3+ recognizes accounts by
  // providerId + accountId instead. Kept optional so existing rows remain valid.
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model Category {
  id                  String  @id @default(uuid())
  name                String
  slug                String
  description         String?
  image               String?
  imagePublicId       String?
  mobileImage         String?
  mobileImagePublicId String?
  isActive            Boolean @default(true)

  children         Category[]       @relation("CategoryHierarchy")
  products         Product[]
  couponCategories CouponCategory[]

  parentId String?
  parent   Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([parentId])
  @@map("category")
}

model Brand {
  id           String  @id @default(uuid())
  name         String
  slug         String
  logo         String?
  logoPublicId String?
  description  String?
  isActive     Boolean @default(true)

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("brand")
}

model Product {
  id              String        @id @default(uuid())
  name            String
  slug            String
  description     String?
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  salesCount30d   Int           @default(0)
  trendingScore   Float         @default(0)
  averageRating   Float         @default(0)
  reviewCount     Int           @default(0)
  metaTitle       String?
  metaDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  variants        ProductVariant[]
  images          ProductImage[]
  reviews         Review[]
  couponProducts  CouponProduct[]
  cartItems       CartItem[]
  collectionItems ProductCollectionItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([status, deletedAt, createdAt])
  @@index([categoryId, status, deletedAt, createdAt])
  @@index([brandId, status, deletedAt, createdAt])
  @@index([status, isFeatured, deletedAt, createdAt])
  @@index([status, deletedAt, salesCount30d(sort: Desc)])
  @@index([status, deletedAt, trendingScore(sort: Desc)])
  @@map("product")
}

model ProductVariant {
  id             String   @id @default(uuid())
  sku            String
  barcode        String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(18, 2)
  weight         Decimal? @db.Decimal(10, 2)
  isDefault      Boolean  @default(false)

  attributes            VariantAttribute[]
  inventories           Inventory[]
  orderItems            OrderItem[]
  wishlistItems         WishlistItem[]
  stockReservations     StockReservation[]
  transferItems         InventoryTransferItem[]
  cartItems             CartItem[]
  inventoryTransactions InventoryTransaction[]
  inventoryAdjustments  InventoryAdjustment[]
  inventoryEvents       InventoryEvent[]

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@map("product_variant")
}

model Attribute {
  id   String @id @default(uuid())
  name String @unique

  values AttributeValue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("attribute")
}

model AttributeValue {
  id    String  @id @default(uuid())
  value String
  color String?

  variants VariantAttribute[]

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([attributeId, value])
  @@index([deletedAt])
  @@map("attribute_value")
}

model VariantAttribute {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute")
}

model ProductImage {
  id        String  @id @default(uuid())
  imageUrl  String
  publicId  String?
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_image")
}

model Review {
  id               String   @id @default(uuid())
  rating           Int
  comment          String?
  images           String[]
  isApproved       Boolean  @default(false)
  rejectionReason  String?
  verifiedPurchase Boolean  @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, customerProfileId])
  @@index([customerProfileId])
  @@index([isApproved])
  @@map("review")
}

model CustomerProfile {
  id            String        @id @default(uuid())
  customerCode  String        @unique
  dateOfBirth   DateTime?
  gender        Gender?
  loyaltyPoints Int           @default(0)
  totalOrders   Int           @default(0)
  totalSpent    Decimal       @default(0) @db.Decimal(18, 2)
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  couponUsages  CouponUsage[]
  wishlist      Wishlist?
  reviews       Review[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("customer_profile")
}

model Address {
  id                String  @id @default(uuid())
  label             String?
  fullName          String
  phone             String
  email             String?
  country           String  @default("Bangladesh")
  division          String
  district          String
  thana             String?
  area              String?
  postalCode        String?
  divisionCode      String?
  districtCode      String?
  upazilaCode       String?
  addressLine1      String
  addressLine2      String?
  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerProfileId])
  @@index([country])
  @@index([division])
  @@index([district])
  @@index([districtCode])
  @@map("address")
}

model Wishlist {
  id String @id @default(uuid())

  items WishlistItem[]

  customerProfileId String          @unique
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wishlist")
}

model WishlistItem {
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([wishlistId, variantId])
  @@index([variantId])
  @@map("wishlist_item")
}

model Cart {
  id             String     @id @default(uuid())
  status         CartStatus @default(ACTIVE)
  subtotal       Decimal    @default(0) @db.Decimal(18, 2)
  discountAmount Decimal    @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(18, 2)
  shippingAmount Decimal    @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal    @default(0) @db.Decimal(18, 2)

  items      CartItem[]
  activities CartActivity[]
  coupon     CartCoupon?

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([customerProfileId, status])
  @@map("cart")
}

model CartItem {
  id           String  @id @default(uuid())
  quantity     Int
  productName  String
  productSlug  String?
  productImage String?
  sku          String
  unitPrice    Decimal @db.Decimal(18, 2)
  subtotal     Decimal @db.Decimal(18, 2)

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_item")
}

model CartCoupon {
  id             String  @id @default(uuid())
  couponCode     String
  discountAmount Decimal @db.Decimal(18, 2)

  cartId String @unique
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  appliedAt DateTime @default(now())

  @@map("cart_coupon")
}

model CartActivity {
  id        String        @id @default(uuid())
  eventType CartEventType
  metadata  Json?

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@map("cart_activity")
}

model Order {
  id                 String            @id @default(uuid())
  orderNumber        String            @unique
  status             OrderStatus       @default(PENDING)
  paymentStatus      PaymentStatus     @default(PENDING)
  fulfillmentStatus  FulfillmentStatus @default(UNFULFILLED)
  currency           Currency          @default(BDT)
  subtotal           Decimal           @db.Decimal(18, 2)
  discountAmount     Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal           @default(0) @db.Decimal(18, 2)
  // Pricing configuration captured at checkout so historical line tax and
  // reporting never depend on the current platform setting.
  pricesIncludeTax   Boolean           @default(true)
  taxRatePercent     Decimal           @default(0) @db.Decimal(5, 2)
  shippingAmount     Decimal           @default(0) @db.Decimal(18, 2)
  shippingMethodName String?
  shippingMethodCode String?
  shippingZoneId     String?
  shippingZoneName   String?
  shippingZoneCode   String?
  shippingRateId     String?
  shippingRatePrice  Decimal?          @db.Decimal(18, 2)
  grandTotal         Decimal           @db.Decimal(18, 2)
  notes              String?

  items          OrderItem[]
  payments       Payment[]
  events         OrderEvent[]
  statusHistory  OrderStatusHistory[]
  shipments      Shipment[]
  couponUsages   CouponUsage[]
  returnRequests ReturnRequest[]
  addresses      OrderAddress[]

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerProfileId, createdAt])
  @@index([status, createdAt])
  @@index([currency, deliveredAt])
  @@map("order")
}

model OrderItem {
  id                String    @id @default(uuid())
  productName       String
  sku               String
  variantName       String?
  quantity          Int
  unitPrice         Decimal   @db.Decimal(18, 2)
  costPrice         Decimal?  @db.Decimal(18, 2)
  // Manual cost snapshot captured at order placement. This is NOT FIFO or
  // weighted-average costing; it is the current variant cost when the sale was
  // placed (or null when unknown).
  costSource        String?
  costCapturedAt    DateTime?
  discountAmount    Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(18, 2)
  // 1 = per-line discount/tax was allocated by the current server. 0 = legacy
  // row that only has order-level amounts and needs a reporting fallback.
  allocationVersion Int       @default(0)
  subtotal          Decimal   @db.Decimal(18, 2)

  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([sku])
  @@index([variantId])
  @@map("order_item")
}

model ReturnRequest {
  id                   String              @id @default(uuid())
  status               ReturnRequestStatus @default(PENDING)
  reason               String?
  requestedAt          DateTime            @default(now())
  reviewedAt           DateTime?
  reviewedBy           String?
  adminNote            String?
  // Shipping reversal included in the refund created for a full return.
  // Cash reporting counts it only once the linked refund is COMPLETED.
  shippingRefundAmount Decimal             @default(0) @db.Decimal(18, 2)

  items  ReturnItem[]
  refund Refund?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([status, reviewedAt])
  @@map("return_request")
}

model ReturnItem {
  id                    String          @id @default(uuid())
  quantity              Int
  restockOrRefund       RestockOrRefund
  // Physical disposition, distinct from the refund decision. A RESTOCK item
  // that is damaged is NOT put back into resalable inventory.
  restockToStock        Boolean         @default(false)
  damaged               Boolean         @default(false)
  // Immutable snapshot of the sales and cost reversal recorded at approval.
  // Sales adjustment is tax-exclusive net merchandise; cost adjustment is the
  // original OrderItem.costPrice x returned quantity, only for resalable stock.
  salesAdjustmentAmount Decimal         @default(0) @db.Decimal(18, 2)
  costAdjustmentAmount  Decimal         @default(0) @db.Decimal(18, 2)
  // 1 = amounts were snapshotted at approval. 0 = legacy approval.
  allocationVersion     Int             @default(0)

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_item")
}

model OrderAddress {
  id           String      @id @default(uuid())
  type         AddressType
  fullName     String
  phone        String
  email        String?
  country      String      @default("Bangladesh")
  division     String
  district     String
  thana        String?
  postalCode   String?
  divisionCode String?
  districtCode String?
  upazilaCode  String?
  addressLine1 String
  addressLine2 String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([districtCode])
  @@map("order_address")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  status    OrderStatus
  remarks   String?
  changedBy String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("order_status_history")
}

model OrderEvent {
  id        String         @id @default(uuid())
  eventType OrderEventType
  metadata  Json?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("order_event")
}

model Payment {
  id                String                   @id @default(uuid())
  method            PaymentMethod
  status            PaymentTransactionStatus @default(PENDING)
  amount            Decimal                  @db.Decimal(18, 2)
  currency          Currency                 @default(BDT)
  provider          String?
  providerReference String?                  @unique
  checkoutUrl       String?
  paymentIntentId   String?
  valId             String?                  @unique
  bankTranId        String?                  @unique
  paidAt            DateTime?
  expiresAt         DateTime?

  refunds      Refund[]
  transactions PaymentTransaction[]
  events       PaymentEvent[]
  orderId      String
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([status, paidAt])
  @@map("payment")
}

model PaymentTransaction {
  id                   String                   @id @default(uuid())
  transactionReference String?
  gatewayResponse      Json?
  status               PaymentTransactionStatus
  amount               Decimal                  @db.Decimal(18, 2)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@map("payment_transaction")
}

model Refund {
  id                       String       @id @default(uuid())
  amount                   Decimal      @db.Decimal(18, 2)
  reason                   String?
  status                   RefundStatus @default(PENDING)
  providerReference        String?
  refundedAt               DateTime?
  requiresManualProcessing Boolean      @default(false)
  requestedBy              String?
  approvedBy               String?
  completedBy              String?

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // A refund created by a return approval is linked so it cannot be duplicated
  // and so completed shipping reversals can be identified without re-deriving
  // them from mutable order data.
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([status, refundedAt])
  @@map("refund")
}

model PaymentWebhookLog {
  id              String    @id @default(uuid())
  provider        String
  eventType       String
  externalEventId String
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalEventId])
  @@index([processed])
  @@map("payment_webhook_log")
}

model PaymentEvent {
  id        String           @id @default(uuid())
  eventType PaymentEventType
  metadata  Json?

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@map("payment_event")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  isSecret  Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_setting")
}

model PlatformSettingAudit {
  id         String   @id @default(uuid())
  settingKey String
  changedBy  String?
  oldValue   Json?
  newValue   Json?
  changedAt  DateTime @default(now())

  @@index([settingKey, changedAt])
  @@map("platform_setting_audit")
}

model Warehouse {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  phone        String?
  email        String?
  country      String
  state        String?
  city         String
  addressLine1 String
  addressLine2 String?
  isActive     Boolean @default(true)

  inventories       Inventory[]
  stockReservations StockReservation[]
  transactions      InventoryTransaction[]
  adjustments       InventoryAdjustment[]
  shipments         Shipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("warehouse")
}

model Inventory {
  id                String    @id @default(uuid())
  quantityOnHand    Int       @default(0)
  quantityReserved  Int       @default(0)
  quantityAvailable Int       @default(0)
  lastTransactionAt DateTime?

  // Who/when the stock level was last changed by an explicit admin action
  // (stock set, adjustment approval, transfer). Kept separate from updatedAt,
  // which also moves on order-driven reservations.
  lastUpdatedBy  String?
  stockUpdatedAt DateTime?

  transactions InventoryTransaction[]

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@map("inventory")
}

model StockReservation {
  id        String   @id @default(uuid())
  orderId   String
  quantity  Int
  expiresAt DateTime

  variantId String
