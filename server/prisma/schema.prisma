model Coupon {
  id                    String       @id @default(uuid())
  code                  String       @unique
  name                  String
  description           String?
  status                CouponStatus @default(DRAFT)
  discountType          DiscountType
  discountValue         Decimal      @db.Decimal(18, 2)
  minimumOrderAmount    Decimal?     @db.Decimal(18, 2)
  maximumDiscountAmount Decimal?     @db.Decimal(18, 2)
  usageLimit            Int?
  usageCount            Int          @default(0)
  usageLimitPerCustomer Int?
  startsAt              DateTime
  expiresAt             DateTime
  isActive              Boolean      @default(true)
  applicableProductIds  String[]
  applicableCategoryIds String[]

  products   CouponProduct[]
  categories CouponCategory[]
  usages     CouponUsage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, deletedAt, createdAt])
  @@map("coupon")
}

model CouponUsage {
  id             String  @id @default(uuid())
  discountAmount Decimal @db.Decimal(18, 2)

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  usedAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([customerProfileId])
  @@index([couponId, customerProfileId])
  @@map("coupon_usage")
}

model CouponProduct {
