# ---------------------------------------------------------------------------
# Ayra API - copy to server/.env and replace every placeholder.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed by Better Auth (comma-separated, wildcards OK).
# Example: https://*.preview.example.com,https://staging.example.com
EXTRA_TRUSTED_ORIGINS=
BETTER_AUTH_APP_NAME=Ayra

# Database (PostgreSQL 16+). DIRECT_URL is used by Prisma migrations.
DATABASE_URL=postgresql://ayra:change-me@localhost:5432/ayra?schema=public
DIRECT_URL=postgresql://ayra:change-me@localhost:5432/ayra?schema=public
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=20000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_KEEPALIVE_INITIAL_DELAY_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_TRANSACTION_MAX_WAIT_MS=10000

# Redis (required outside NODE_ENV=test)
REDIS_URL=redis://localhost:6379

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-generate-a-32-byte-secret
BETTER_AUTH_URL=http://localhost:5000

# Optional dedicated key for encrypting platform-setting secrets.
# Falls back to BETTER_AUTH_SECRET when unset. Set this before storing
# payment secrets; changing it makes already-stored secrets undecryptable.
# SETTINGS_ENCRYPTION_KEY=change-me-generate-a-32-byte-secret

# Reserved JWT settings. Required by the env schema but currently unused.
ACCESS_TOKEN_SECRET=change-me-reserved
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-reserved
REFRESH_TOKEN_EXPIRES_IN=7d

# Token/cache/rate limits
ENABLE_CACHE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY_HOPS=1
MAX_JSON_SIZE=1mb
URL_ENCODED=true
LOW_STOCK_THRESHOLD=10

# API docs (enabled automatically outside production)
# ENABLE_API_DOCS=true

# Email (Resend is required by the schema; SMTP is optional)
RESEND_FROM=no-reply@example.com
# RESEND_API_KEY=re_change_me
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Payments (SSLCommerz sandbox by default; COD is always available)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# PAYMENT_CALLBACK_BASE_URL=http://localhost:5000


# Courier API integrations (optional). Manual courier booking still works
# without these; API booking and webhooks stay disabled until configured.
# Webhooks: POST /api/v1/webhooks/couriers/pathao and .../steadfast
# Send an HMAC-SHA256 hex signature of the raw JSON body in
# X-PATHAO-SIGNATURE / X-STEADFAST-SIGNATURE, or the shared secret in
# X-WEBHOOK-SECRET. Configure the matching *_WEBHOOK_SECRET below.
# COURIER_HTTP_TIMEOUT_MS=15000
# PATHAO_BASE_URL=https://api-hermes.pathao.com
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=
# PATHAO_PASSWORD=
# PATHAO_STORE_ID=
# PATHAO_DEFAULT_CITY_ID=
# PATHAO_DEFAULT_ZONE_ID=
# PATHAO_DEFAULT_AREA_ID=
# PATHAO_WEBHOOK_SECRET=
# STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# STEADFAST_WEBHOOK_SECRET=

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudinary media uploads (optional; uploads fail without these)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_TIMEOUT_MS=60000
CLOUDINARY_DESTROY_TIMEOUT_MS=8000
CLOUDINARY_RECONCILE_TIMEOUT_MS=8000
MEDIA_DB_WRITE_TIMEOUT_MS=8000

# Gemini (optional product assistant)
# GEMINI_API_KEY=

# Bangladesh geography reference API (proxied by the server and cached in memory)
GEO_API_URL=https://bd-geo-location.vercel.app/api/v1
GEO_API_TIMEOUT_MS=8000
GEO_CACHE_TTL_SECONDS=86400

# Admin bootstrap (npm run seed:admin). Seeded admins are verified by default.
ADMIN_NAME=Ayra Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-use-a-strong-password
ADMIN_ROLE=ADMIN
ADMIN_EMAIL_VERIFIED=true
