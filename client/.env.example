# ---------------------------------------------------------------------------
# Ayra storefront - copy to client/.env and replace placeholders.
# NEXT_PUBLIC_* values are embedded at build time.
# ---------------------------------------------------------------------------

# Server-side proxy target (Next rewrites + server components)
BACKEND_ORIGIN=http://localhost:5000

# Public site metadata and branding
NEXT_PUBLIC_SITE_NAME=Ayra
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOGO=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Better Auth. Leave empty to use the same-origin /backend-proxy path.
NEXT_PUBLIC_BETTER_AUTH_URL=
NEXT_PUBLIC_CALLBACK_URL=http://localhost:3000

# Request timeouts
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=240000
NEXT_PUBLIC_PRODUCT_API_TIMEOUT_MS=30000
